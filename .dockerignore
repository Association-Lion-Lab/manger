# Deny by default, including unknown backup/configuration file formats.
**
!**/*.js
!public/**
!package.json
!package-lock.json
!LICENSE

# Re-exclude non-runtime trees, even when they contain JavaScript.
**/.git
**/.forgejo
**/.github
**/node_modules
**/data
**/tls
**/secrets
**/backups
**/recovery
**/docs
**/work
**/test
**/tests
**/scripts
**/coverage
**/graphify-out
**/*.test.js
**/*.spec.js

# These must stay excluded even if accidentally placed under public/.
**/.*
**/.env
**/.env.*
**/.npmrc
**/*.db*
**/*.sqlite*
**/*.key
**/*.pem
**/*.crt
**/*.cer
**/*.der
**/*.p12
**/*.pfx
**/id_*
**/*.bak
**/*.old
**/*.log
**/*.zip
**/*.tar*
**/*.gz
**/*.sql
**/compose*.yaml
**/compose*.yml
