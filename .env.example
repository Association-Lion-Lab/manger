# Adresse IPv4 presente sur le serveur. Par defaut : toutes les interfaces.
# Pour un acces LAN/VPN route, remplacer par l'adresse LAN du serveur.
# Ce choix ne filtre pas les adresses des clients.
MANGER_BIND_ADDRESS=0.0.0.0
MANGER_HTTP_PORT=3000

# Invitations SMTP facultatives : HOST vide = aucun envoi depuis le serveur.
# Port 465 = TLS direct ; autres ports = STARTTLS obligatoire.
# FROM doit etre autorise par le fournisseur. URL exacte accessible en Wi-Fi/VPN.
# USER et PASSWORD ensemble, ou tous deux vides pour un relais sans authentification.
MANGER_SMTP_HOST=
MANGER_SMTP_PORT=587
MANGER_SMTP_FROM=
MANGER_SMTP_USER=
MANGER_SMTP_PASSWORD=
MANGER_APP_URL=
